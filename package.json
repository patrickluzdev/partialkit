{
  "name": "partialkit",
  "version": "0.0.0",
  "description": "shadcn-inspired UI components for plain HTML. Tailwind CSS classes plus a small ESM runtime, for any project that writes HTML.",
  "keywords": [
    "ui",
    "components",
    "tailwindcss",
    "html",
    "css-library",
    "design-system",
    "accessibility",
    "vanilla-js",
    "hypermedia",
    "htmx"
  ],
  "license": "MIT",
  "author": "Patrick Luz <eu@patrickluz.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickluzdev/partialkit.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/esm/auto.js",
    "*.css"
  ],
  "files": [
    "dist",
    "src/css"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./auto": {
      "types": "./dist/esm/auto.d.ts",
      "import": "./dist/esm/auto.js"
    },
    "./css": "./dist/partialkit.css",
    "./css/source": "./src/css/index.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:bundle && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:bundle": "esbuild src/js/auto.ts --bundle --format=esm --target=es2022 --outfile=dist/partialkit.js && esbuild src/js/auto.ts --bundle --minify --format=esm --target=es2022 --outfile=dist/partialkit.min.js",
    "build:css": "tailwindcss -i src/css/dist.css -o dist/partialkit.css && tailwindcss -i src/css/dist.css -o dist/partialkit.min.css --minify",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "docs:assets": "node scripts/copy-dist.js",
    "docs:dev": "npm run build && npm run docs:assets && astro dev --root docs",
    "docs:build": "npm run build && npm run docs:assets && astro build --root docs",
    "docs:preview": "node scripts/serve-docs.js",
    "dev": "npm run docs:dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:all": "playwright test",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --grep @visual --update-snapshots",
    "test:docker": "docker run --rm --network host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "astro": "^7.2.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
