---
import { Code } from "@astrojs/starlight/components";

interface Props {
  /** Path under src/examples, without the .html extension. Rendered live and shown as code. */
  src: string;
  /** Arrangement of the example itself. Never leaks into the code panel. */
  layout?: "block" | "row" | "stack";
  /** Constrains the rendered example, for components that would otherwise span the page. */
  width?: "sm" | "md";
}

// Examples live as real .html files: the code panel then shows exactly what the
// file contains, indentation included, and the preview renders the same string.
const examples = import.meta.glob<string>("../examples/**/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { src, layout = "block", width } = Astro.props;
const key = `../examples/${src}.html`;
const source = examples[key];

if (source === undefined) {
  throw new Error(`Unknown example "${src}". Expected docs/src/examples/${src}.html`);
}

const code = source.replace(/\n+$/, "");
---

<div class="pk-example not-content">
  <div
    class="pk-preview pk-surface"
    data-example={src}
    data-layout={layout}
    data-width={width}
    set:html={code}
  />

  <div class="pk-example-bar">
    <button class="pk-example-toggle" type="button" data-pk-code-toggle aria-expanded="false">
      Show code
    </button>
  </div>

  <div class="pk-example-code" hidden>
    <Code code={code} lang="html" />
  </div>
</div>

<script>
  // Not `auto`: that registers partialkit's own theme component, which would fight
  // Starlight for the dark class and win on reload. Starlight owns the theme here.
  import { checkbox, dialog, dropdownMenu, register, slider, start } from "../../../src/js/index.ts";

  register(checkbox);
  register(dialog);
  register(dropdownMenu);
  register(slider);
  start();

  document.addEventListener("click", (event) => {
    const toggle = (event.target as Element | null)?.closest<HTMLElement>("[data-pk-code-toggle]");
    if (!toggle) return;

    const panel = toggle.closest(".pk-example")?.querySelector<HTMLElement>(".pk-example-code");
    if (!panel) return;

    panel.hidden = !panel.hidden;
    toggle.setAttribute("aria-expanded", String(!panel.hidden));
    toggle.textContent = panel.hidden ? "Show code" : "Hide code";
  });
</script>
